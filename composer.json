{
  "name": "mertaydin/laravel-server-security-update-monitor",
  "description": "Monitor Linux server package updates and security patches from a Laravel dashboard.",
  "keywords": ["laravel", "server", "security", "updates", "apt", "monitor"],
  "license": "MIT",
  "authors": [{"name": "Mert Aydın"}],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/view": "^10.0|^11.0|^12.0"
  },
  "autoload": {"psr-4": {"MertAydin\\ServerSecurityUpdateMonitor\\": "src/"}},
  "extra": {"laravel": {"providers": ["MertAydin\\ServerSecurityUpdateMonitor\\ServerSecurityUpdateMonitorServiceProvider"]}},
  "minimum-stability": "stable",
  "prefer-stable": true
}

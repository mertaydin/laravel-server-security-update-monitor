{
  "name": "mertaydin/laravel-server-security-update-monitor",
  "description": "Monitor Linux server package updates and security patches from a Laravel dashboard.",
  "keywords": [
    "laravel",
    "server",
    "security",
    "updates",
    "apt",
    "monitor",
    "dnf",
    "yum",
    "rpm",
    "fedora",
    "alpine",
    "apk"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Mert Aydın"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/process": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "MertAydin\\ServerSecurityUpdateMonitor\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MertAydin\\ServerSecurityUpdateMonitor\\ServerSecurityUpdateMonitorServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "type": "library",
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
    "laravel/pint": "^1.0"
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint --test"
  }
}
